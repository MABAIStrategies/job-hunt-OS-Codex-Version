{
  "manifest_version": 3,
  "name": "Job Hunt OS — Tailor & Track",
  "short_name": "Job Hunt OS",
  "version": "0.2.1",
  "description": "Tailor a truthful, ATS-optimized resume + cover letter to any job page in one click, find jobs you are likely to land, and track everything in Google Sheets.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Job Hunt OS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "tailor-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Tailor resume + cover letter to the job on this page"
    }
  }
}
