# Optional single-user HTTP Basic Auth gate for Vercel deployments.
# Leave unset for local/browser-only mode. Set both values in Vercel env vars to require login.
JOB_HUNT_AUTH_EMAIL=
JOB_HUNT_AUTH_PASSWORD=

# Future production integrations.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK_URL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=
