# Single-user HTTP Basic Auth gate. Required in production: if either value is
# unset there, the app returns 503 for every request. May be left unset for local `npm run dev`.
JOB_HUNT_AUTH_EMAIL=
JOB_HUNT_AUTH_PASSWORD=

# Future production integrations.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK_URL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=
